{
  "name": "@flesler/cursor-canvas-web",
  "private": false,
  "version": "1.0.1",
  "repository": "github:flesler/cursor-canvas-web",
  "type": "module",
  "description": "Deploy your Cursor canvases to the web.",
  "license": "MIT",
  "keywords": [
    "cursor",
    "canvas",
    "mantine",
    "react",
    "shim"
  ],
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/cursor-canvas.cjs",
  "module": "./dist/cursor-canvas.js",
  "types": "./dist/shim/cursor-canvas.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shim/cursor-canvas.d.ts",
      "import": "./dist/cursor-canvas.js",
      "require": "./dist/cursor-canvas.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:sdk": "bash scripts/sync-cursor-sdk-snapshot.sh",
    "check:sdk-exports": "node scripts/diff-sdk-exports.mjs",
    "test:contract": "pnpm run build:lib && pnpm run check:sdk-exports",
    "check:sdk-live": "node scripts/diff-sdk-exports.mjs \"${HOME}/.cursor/skills-cursor/canvas/sdk/index.d.ts\"",
    "test:contract:strict": "pnpm run build:lib && node scripts/generate-contract-consumer.mjs && pnpm exec tsc -p test/contract/tsconfig.json",
    "test:contract:ci": "pnpm run test:contract",
    "sync:demo": "bash scripts/sync-demo-canvas.sh",
    "demo:screenshot": "bash scripts/readme-screenshot.sh",
    "ci:local": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:contract:ci",
    "prepare": "[ \"$CI\" != \"true\" ] && [ -d node_modules/husky ] && husky || true",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build:lib"
  },
  "peerDependencies": {
    "@mantine/charts": "^8.3.0",
    "@mantine/core": "^8.3.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "recharts": "^2.15.0 || ^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^3.0.5"
  }
}

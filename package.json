{
  "name": "@flesler/cursor-canvas-web",
  "private": false,
  "version": "1.3.0",
  "repository": "github:flesler/cursor-canvas-web",
  "type": "module",
  "description": "Deploy your Cursor canvases to the web.",
  "license": "MIT",
  "keywords": [
    "cursor",
    "canvas",
    "mantine",
    "react",
    "shim"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/vendor",
    "src/superset"
  ],
  "main": "./dist/cursor-canvas.cjs",
  "module": "./dist/cursor-canvas.js",
  "types": "./src/superset/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/superset/index.d.ts",
      "import": "./dist/cursor-canvas.js",
      "require": "./dist/cursor-canvas.cjs"
    },
    "./canvas-sdk": {
      "types": "./src/vendor/canvas-sdk/index.d.ts"
    },
    "./superset": {
      "types": "./src/superset/index.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint --cache --cache-strategy content",
    "lint": "npm run eslint -- 'src/**/*.{ts,tsx}' 'scripts/**/*.ts' 'vite.config.ts' 'vite.lib.config.ts'",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:sdk": "bash scripts/sync-cursor-sdk-snapshot.sh",
    "patch:vendor-paths": "tsx scripts/patch-vendor-paths.ts",
    "check:sdk-exports": "tsx scripts/diff-sdk-exports.ts --strict",
    "generate:contract-consumer": "tsx scripts/generate-contract-consumer.ts && npm run eslint -- --fix src/contract/consumer.ts",
    "test:contract": "npm run check:sdk-exports && npm run generate:contract-consumer && tsc --noEmit && npm run build:lib",
    "test:contract:fast": "npm run check:sdk-exports && npm run generate:contract-consumer && tsc --noEmit",
    "check:sdk-live": "tsx scripts/diff-sdk-exports.ts --strict \"${HOME}/.cursor/skills-cursor/canvas/sdk/index.d.ts\"",
    "test:contract:strict": "npm run test:contract",
    "test:contract:ci": "npm run test:contract",
    "sync:demo": "bash scripts/sync-demo-canvas.sh",
    "demo:screenshot": "bash scripts/readme-screenshot.sh",
    "test:demo-screenshots": "bash scripts/test-demo-screenshots.sh",
    "test:demo-screenshots:update": "bash scripts/test-demo-screenshots.sh --update",
    "test:render-compat": "bash scripts/test-render-compat.sh",
    "ci:local": "npm run typecheck && npm run lint:fix && npm test && npm run test:contract:ci",
    "prepare": "[ \"$CI\" != \"true\" ] && [ -d node_modules/husky ] && husky || true",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:sdk-exports && npm run build:lib"
  },
  "overrides": {
    "vitest": "^4.1.11",
    "@vitest/mocker": "^4.1.11"
  },
  "peerDependencies": {
    "@mantine/charts": "^8.3.0",
    "@mantine/core": "^8.3.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "recharts": "^2.15.0 || ^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.11"
  }
}

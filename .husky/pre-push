#!/bin/sh

if ! command -v npm >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
  nvm use
fi

if ! npm test; then
  echo "pre-push: test failed"
  exit 1
fi

if ! npm run test:contract:fast; then
  echo "pre-push: test:contract:fast failed"
  exit 1
fi

if ! git diff --quiet -- src/contract/consumer.ts; then
  echo "pre-push: src/contract/consumer.ts changed (SDK exports drift)."
  echo "  Commit it: npm run generate:contract-consumer && git add src/contract/consumer.ts"
  exit 1
fi
